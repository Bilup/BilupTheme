<footer class="footer">
    <div class="footer-container">
        <div class="footer-section">
            <h3 class="footer-title">BilupTheme</h3>
            <p class="footer-description"><%= t('footer.description') %></p>
        </div>

        <div class="footer-section">
            <h4 class="footer-heading"><%= t('footer.links') %></h4>
            <ul class="footer-links">
                <li><a href="/about" class="footer-link <%= ActivePage === 'about' ? 'active' : '' %>"><%= t('about.title') %></a></li>
            </ul>
        </div>

        <div class="footer-section">
            <h4 class="footer-heading"><%= t('footer.community') %></h4>
            <ul class="footer-links">
                <li><a href="/themes" class="footer-link"><%= t('footer.browseThemes') %></a></li>
                <li><a href="/upload" class="footer-link"><%= t('footer.uploadTheme') %></a></li>
            </ul>
        </div>

        <div class="footer-section">
            <h4 class="footer-heading"><%= t('footer.serviceProvidedBy') %></h4>
            <ul class="footer-links">
                <li><a href="https://github.com/Bilup" class="footer-link" target="_blank" rel="noopener noreferrer">@Bilup</a></li>
            </ul>
        </div>
    </div>
</footer>
