<div id="edit-theme-modal" class="modal-overlay" style="display: none;">
    <div class="modal edit-theme-modal">
        <div class="modal-header">
            <h2><%= t('common.edit') %> Theme</h2>
            <button class="close-modal" data-close-modal="edit-theme-modal">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="modal-body">
            <form class="edit-form" id="edit-theme-form">
                <input type="hidden" id="edit-theme-uuid">
                
                <div class="form-group">
                    <label for="edit-theme-name"><%= t('upload.themeName') %></label>
                    <input type="text" id="edit-theme-name" name="name" required maxlength="100">
                </div>
                
                <div class="form-group">
                    <label for="edit-theme-description"><%= t('upload.themeDescription') %></label>
                    <textarea id="edit-theme-description" name="description" placeholder="<%= t('upload.themeDescription') %>" maxlength="500"></textarea>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn secondary" data-close-modal="edit-theme-modal"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn primary" id="edit-theme-save-btn">
                        <i data-lucide="save"></i> <%= t('common.save') %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
