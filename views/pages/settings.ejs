<!DOCTYPE html>
<html lang="<%= Lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - BilupTheme</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <script src="/static/js/lucide.js"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
    <style>.settings-container .btn { border-radius: 50px; }</style>
</head>
<body>
    <%- include('../partials/nav', { ...locals }) %>
    
    <main class="main-content">
        <div class="settings-container">
            <h1 class="settings-title"><i data-lucide="settings"></i> <%= t('settings.title') %></h1>

            <div class="settings-section">
                <div class="section-icon-wrapper"><i data-lucide="download"></i></div>
                <div class="section-content">
                    <h2 class="section-title"><%= t('settings.downloadTitle') %></h2>
                    <p class="section-description"><%= t('settings.downloadDescription') %></p>
                    <button id="download-all-btn" class="btn primary"><i data-lucide="download"></i> <%= t('settings.downloadBtn') %></button>
                </div>
            </div>

            <div class="settings-section danger-zone">
                <div class="section-icon-wrapper"><i data-lucide="alert-triangle"></i></div>
                <div class="section-content">
                    <h2 class="section-title"><%= t('settings.dangerZone') %></h2>
                    <p class="section-description"><%= t('settings.dangerZoneDescription') %></p>
                    <div class="danger-zone-actions">
                        <button id="delete-data-btn" class="btn danger"><i data-lucide="trash-2"></i> <%= t('settings.deleteAllData') %></button>
                        <button id="logout-btn" class="btn danger"><i data-lucide="log-out"></i> <%= t('nav.logout') %></button>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <div id="confirm-modal" class="modal-overlay" style="display: none;">
        <div class="modal">
            <div class="modal-header">
                <h2 id="modal-title"><%= t('settings.confirmAction') %></h2>
                <button class="close-modal" id="close-modal"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body"><p id="modal-message"><%= t('settings.confirmDeleteAll') %></p></div>
            <div class="modal-footer">
                <button type="button" id="cancel-modal" class="btn secondary"><%= t('common.cancel') %></button>
                <button type="button" id="confirm-modal-btn" class="btn danger"><%= t('common.confirm') %></button>
            </div>
        </div>
    </div>

    <div id="i18n-settings" style="display: none;" data-confirm-delete-all="<%= t('settings.confirmDeleteAll') %>"></div>

    <%- include('../partials/footer', { ...locals }) %>
    <script src="/static/js/main.js"></script>
    <script src="/static/js/settings.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
