<!DOCTYPE html>
<html lang="<%= Lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilupTheme - Browse Themes</title>
    <script src="/static/js/lucide.js"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    <%- include('../partials/nav', { ...locals }) %>

    <main class="main-content">
        <section class="toolbar">
            <div class="search-bar">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" id="search-input" placeholder="<%= t('themes.searchPlaceholder') %>" />
            </div>
            <div class="filter-controls">
                <label for="color-select"><%= t('themes.color') %></label>
                <select id="color-select">
                    <option value=""><%= t('themes.allColors') %></option>
                    <option value="red"><%= t('themes.red') %></option>
                    <option value="orange"><%= t('themes.orange') %></option>
                    <option value="yellow"><%= t('themes.yellow') %></option>
                    <option value="green"><%= t('themes.green') %></option>
                    <option value="blue"><%= t('themes.blue') %></option>
                    <option value="purple"><%= t('themes.purple') %></option>
                    <option value="pink"><%= t('themes.pink') %></option>
                </select>
            </div>
            <div class="filter-controls">
                <label for="platform-select"><%= t('themes.platform') %></label>
                <select id="platform-select">
                    <option value=""><%= t('themes.allPlatforms') %></option>
                    <% if (Mods) { %>
                    <% Object.keys(Mods).forEach(function(id) { var m = Mods[id]; %>
                    <option value="<%= id %>" <%= PlatformFilter === id ? 'selected' : '' %>><%= m.name %></option>
                    <% }); } %>
                </select>
            </div>
            <div class="sort-controls">
                <label for="sort-select"><%= t('themes.sortBy') %></label>
                <select id="sort-select">
                    <option value="newest" <%= SortBy === 'newest' ? 'selected' : '' %>><%= t('themes.newest') %></option>
                    <option value="likes" <%= SortBy === 'likes' ? 'selected' : '' %>><%= t('themes.mostLiked') %></option>
                    <option value="name" <%= SortBy === 'name' ? 'selected' : '' %>><%= t('themes.name') %></option>
                </select>
            </div>
        </section>

        <section id="themes-grid" class="themes-grid" aria-label="Theme gallery">
            <% if (Themes && Themes.length > 0) { %>
                <% Themes.forEach(function(theme) { %>
                    <%- include('../partials/theme-card', { Theme: theme, Mods: Mods, ShowAuthor: true, ShowActions: false, ShowDate: false, Users: Users }) %>
                <% }); %>
            <% } else { %>
            <div class="empty-state">
                <i data-lucide="palette"></i>
                <p><%= t('themes.noThemes') %></p>
                <% if (Authenticated) { %>
                <a href="/upload" class="btn primary"><%= t('upload.uploadBtn') %></a>
                <% } %>
            </div>
            <% } %>
        </section>
    </main>

    <%- include('../partials/footer', { ...locals }) %>

    <script src="/static/js/main.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
