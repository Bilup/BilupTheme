<!DOCTYPE html>
<html lang="<%= Lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About - BilupTheme</title>
    <script src="/static/js/lucide.js"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    <%- include('../partials/nav', { ...locals }) %>

    <main class="main-content">
        <div class="page-header">
            <h1><%= t('about.title') %></h1>
            <p class="subtitle"><%= t('about.description') %></p>
        </div>
        <div class="about-content">
            <section class="about-section">
                <h2><%= t('about.features') %></h2>
                <ul class="feature-list">
                    <li><i data-lucide="palette"></i> <%= t('about.feature1') %></li>
                    <li><i data-lucide="upload"></i> <%= t('about.feature2') %></li>
                    <li><i data-lucide="heart"></i> <%= t('about.feature3') %></li>
                    <li><i data-lucide="users"></i> <%= t('about.feature4') %></li>
                </ul>
            </section>
            <section class="about-section">
                <h2><%= t('about.getInTouch') %></h2>
                <p><%= t('about.contactMessage') %></p>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a href="https://github.com/Bilup/BilupTheme/issues" class="btn primary" target="_blank" rel="noopener noreferrer">
                        <i data-lucide="message-circle"></i>
                        <%= t('about.github') %>
                    </a>
                    <a href="https://qm.qq.com/q/HGvdC8WfGC" class="btn secondary" target="_blank" rel="noopener noreferrer">
                        <i data-lucide="message-circle"></i>
                        <%= t('about.qq') %>
                    </a>
                </div>
            </section>
        </div>
    </main>

    <%- include('../partials/footer', { ...locals }) %>
    <script>lucide.createIcons();</script>
</body>
</html>
