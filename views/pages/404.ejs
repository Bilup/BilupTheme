<!DOCTYPE html>
<html lang="<%= Lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilupTheme - 404 Not Found</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <script src="/static/js/lucide.js"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    <%- include('../partials/nav', { ...locals }) %>

    <main class="main-content">
        <div class="empty-state">
            <i data-lucide="alert-circle"></i>
            <h1>404 - <%= t('404.title') %></h1>
            <p><%= t('404.description') %></p>
            <a href="/themes" class="btn primary"><%= t('footer.browseThemes') %></a>
        </div>
    </main>

    <%- include('../partials/footer', { ...locals }) %>
    <script>lucide.createIcons();</script>
</body>
</html>
