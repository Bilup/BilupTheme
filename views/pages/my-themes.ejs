<!DOCTYPE html>
<html lang="<%= Lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Themes - BilupTheme</title>
    <script src="/static/js/lucide.js"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    <%- include('../partials/nav', { ...locals }) %>

    <main class="main-content">
        <div id="themes-grid" class="themes-grid">
            <% if (Themes && Themes.length > 0) { %>
                <% Themes.forEach(function(theme) { %>
                <%- include('../partials/theme-card', { Theme: theme, Mods: Mods, ShowAuthor: false, ShowActions: true, ShowDate: true, Users: Users }) %>
                <% }); %>
            <% } else { %>
                <%- include('../partials/empty-state', { icon: 'palette', message: t('myThemes.noThemes'), cta: true, ctaUrl: '/upload', ctaText: t('upload.uploadBtn') }) %>
            <% } %>
        </div>

        <div id="rename-modal" class="modal-overlay" style="display: none;">
            <div class="modal">
                <div class="modal-header">
                    <h2><%= t('themeCard.renameTheme') %></h2>
                    <button class="close-modal" id="close-modal">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="rename-name"><%= t('upload.themeName') %> *</label>
                        <input type="text" id="rename-name" name="rename-name" required>
                    </div>
                    <div class="form-group">
                        <label for="rename-description"><%= t('upload.themeDescription') %></label>
                        <textarea id="rename-description" name="rename-description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="cancel-rename" class="btn secondary"><%= t('common.cancel') %></button>
                    <button type="button" id="save-rename" class="btn primary"><%= t('common.save') %></button>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer', { ...locals }) %>
    <script src="/static/js/main.js"></script>
    <script src="/static/js/my-themes.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
